{
  "name": "bible-assistant",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode capacitor",
    "sync": "npm run build:native && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "android:apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run sync && cd android && ./gradlew bundleRelease",
    "icons": "node scripts/icons/buildIcons.mjs",
    "bible:build": "node scripts/bible/buildPacks.mjs",
    "bible:verify": "node scripts/bible/verifyPacks.mjs",
    "bible:counts": "node scripts/bible/buildVerseCounts.mjs",
    "community:verify": "node scripts/community/verifySigning.mjs",
    "community:verify:api": "node scripts/community/verifyBackend.mjs",
    "test": "npm run test:unit && npm run test:component && npm run test:int",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs --project=app --project=mobile --project=pwa",
    "e2e:headed": "node tests/e2e/run.mjs --project=app --project=mobile --headed",
    "e2e:live": "node tests/e2e/run.mjs --project=live",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify": "tsc -b && npm run lint && npm run bible:verify && npm run community:verify && npm run community:verify:api && npm test"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-speech-recognition": "^8.1.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.2.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "saxes": "^6.0.0",
    "sharp": "^0.32.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.1"
  }
}
