sftp.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-native
dist-ssr
*.local

# Downloadable Bible packs — regenerated by `npm run bible:build` and rsync'd
# to the server. The bundled LUT/KJV packs under public/bible-packs/ ARE
# committed: they ship inside the app binary and the texts never change.
build/

# Android release signing — never commit the keystore or its passwords
android/keystore.properties
*.keystore
*.jks

# Bible texts that are still in copyright — ESV (Crossway), NKJV (Thomas
# Nelson), Hoffnung für Alle (Fontis/Biblica) and Schlachter 2000 (Genfer
# Bibelgesellschaft). None of them permits redistributing the complete text,
# so they are kept locally and shipped with `deploy.sh --with-bibles`, exactly
# as the Pixabay ambient tracks are. The four public-domain texts (KJV, Luther
# 1912, Elberfelder 1905, Schlachter 1951) ARE committed.
#
# `bible:build` and `bible:verify` skip a translation whose XML is absent, so a
# clone with only the four still builds, verifies and runs — it just offers
# four translations instead of eight. See THIRD-PARTY-NOTICES.md.
public/bibles/esv.xml
public/bibles/nkjv.xml
public/bibles/hfa.xml
public/bibles/s00.xml

# Server secrets — never commit
public/secrets.php
public/storage/
# Live user dirs pulled off the server for inspection — these contain
# secret.txt and openai_key.txt for real users.
backup/

# Local scratch (audio samples, reference Bibles, etc.)
files/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright output — all regenerated. The E2E tier writes its user data into
# dist/storage/, which the `dist` ignore above already covers.
test-results/
playwright-report/
blob-report/
playwright/.cache/
