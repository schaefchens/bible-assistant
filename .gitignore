sftp.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-native
dist-ssr
*.local

# Downloadable Bible packs — regenerated by `npm run bible:build` and rsync'd
# to the server. The bundled LUT/KJV packs under public/bible-packs/ ARE
# committed: they ship inside the app binary and the texts never change.
build/

# Android release signing — never commit the keystore or its passwords
android/keystore.properties
*.keystore
*.jks

# Server secrets — never commit
public/secrets.php
public/storage/
# Live user dirs pulled off the server for inspection — these contain
# secret.txt and openai_key.txt for real users.
backup/

# Local scratch (audio samples, reference Bibles, etc.)
files/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
