<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Bible Assistant</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Keeps verse reading alive with the screen locked or another app in
	     front. Only has an effect while the AVAudioSession configured in
	     AppDelegate is active and playing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Required: voice input records audio and transcribes it via Whisper.
	     Without this key iOS terminates the app on the first getUserMedia
	     call rather than denying it. Capacitor's WebViewDelegationHandler
	     already grants the WKWebView capture request, so the user sees this
	     prompt exactly once. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Bible Assistant uses the microphone so you can speak Bible references and commands instead of typing them.</string>
	<!-- Separate from the microphone permission: iOS gates SFSpeechRecognizer
	     behind its own consent prompt, and omitting this key crashes the app on
	     the first recognition request. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Bible Assistant turns what you say into text on your device, so it can find the passage you asked for.</string>
	<!-- Light status-bar content over the navy background. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<!-- Opens the app from an invite link's interstitial. Reverse-DNS, matching
	     appId, because custom schemes are not reserved anywhere: two installed
	     apps declaring the same one leaves iOS to pick undefinedly. See
	     src/lib/spaceInvite.ts. -->
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.schaefchens.apps.bibleassistant</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>de.schaefchens.apps.bibleassistant</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
