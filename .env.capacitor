# Loaded by `vite build --mode capacitor` (see vite.config.ts).
#
# The native WebView's own origin is capacitor://localhost (iOS) or
# https://localhost (Android), so the backend origin cannot be inferred at
# runtime the way the web build infers it from import.meta.env.BASE_URL.
#
# These values ship inside the app bundle, so they must not be secret — they
# are just the public address of the PHP backend.

VITE_SERVER_ORIGIN=https://bibleassistant.apps.schaefchens.de

# The app is served from the root of its own subdomain, so there is no path
# prefix. Leave empty (not "/") — origin.ts joins this directly onto the
# origin, and a lone slash would produce "//api.php".
VITE_SERVER_BASE_PATH=
