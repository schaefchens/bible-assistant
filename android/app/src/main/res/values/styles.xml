<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         The Capacitor template ships Theme.AppCompat.Light, whose white window
         background shows through behind the status and navigation bars — on a
         dark app that reads as two white bands top and bottom. This is a dark
         app, so the base theme is dark and the window background follows @color/chrome. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/chrome</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/chrome</item>

        <!-- Measured, not assumed: Capacitor 8 does NOT put this WebView
             edge-to-edge. innerHeight is 867 against a 915px screen, and the
             injected safe-area-inset-top CSS var is 0px — the WebView sits
             below the status bar and the window shows through above it.

             So these colours very much still apply, and transparent was wrong:
             it let the light window background through as a white band. Paint
             them navy to match the app. -->
        <item name="android:statusBarColor">@color/chrome</item>
        <item name="android:navigationBarColor">@color/chrome</item>

        <!-- Dark glyphs, because values/ is now the LIGHT configuration;
             values-night/themes.xml flips them for dark. SystemBars.setStyle()
             also sets these at runtime from the resolved theme, which is what
             makes an in-app override work for the icons even where the bar
             background cannot follow. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- NO android:background here. The Capacitor template puts
             @drawable/splash on it, and that is a *View* attribute, not a window
             one: every view inflated from this Activity's context that doesn't
             set its own background gets the splash bitmap. Native widgets the
             WebView spawns — <select> dropdown rows above all — are exactly
             that, so the app logo turned up as the background of dropdown items.

             It also cannot be undone later. installSplashScreen() switches to
             postSplashScreenTheme via setTheme(), which *merges* rather than
             replaces, so an attribute AppTheme.NoActionBar doesn't define
             survives the switch for the life of the process.

             Nothing is lost by dropping it: the visible splash is drawn by the
             SplashScreen plugin's own ImageView (see capacitor.config.ts —
             androidScaleType CENTER_CROP, launchAutoHide false), and the frame
             before that is windowBackground, which is already navy. -->
        <item name="android:windowBackground">@color/chrome</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/chrome</item>
        <item name="android:navigationBarColor">@color/chrome</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
