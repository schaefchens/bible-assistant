<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark configuration: light glyphs over the dark bar backgrounds that
         values-night/colors.xml supplies. The colours themselves resolve through
         @color/chrome, so only the glyph polarity needs overriding here. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/chrome</item>
        <item name="android:statusBarColor">@color/chrome</item>
        <item name="android:navigationBarColor">@color/chrome</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
