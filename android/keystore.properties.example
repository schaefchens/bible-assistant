# Copy to android/keystore.properties (gitignored) and fill in.
#
# Create the keystore first — keytool lives in the JDK, not on PATH by default:
#
#   mkdir -p ~/keys
#   /opt/homebrew/opt/openjdk@21/bin/keytool -genkeypair -v \
#     -keystore ~/keys/bible-assistant.keystore \
#     -alias bible -keyalg RSA -keysize 4096 -validity 10000
#
# BACK THE KEYSTORE UP OFF-MACHINE. Android identifies an app by its signing
# key: lose it and existing installs can never be updated, only uninstalled
# and reinstalled fresh.

storeFile=/Users/css/keys/bible-assistant.keystore
storePassword=CHANGEME
keyAlias=bible
keyPassword=CHANGEME
